  {
    "id": "dufu-chunwang",
    "title": "春望",
    "poetId": "dufu",
    "content": [
      "国破山河在，城春草木深。",
      "感时花溅泪，恨别鸟惊心。",
      "烽火连三月，家书抵万金。",
      "白头搔更短，浑欲不胜簪。"
    ],
    "form": "五言律诗",
    "anthology": "全唐诗 卷224",
    "themes": [
      "忧国",
      "战乱",
      "思亲"
