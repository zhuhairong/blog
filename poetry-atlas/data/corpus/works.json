  {
    "id": "dufu-wangyue",
    "title": "望岳",
    "poetId": "dufu",
    "content": [
      "岱宗夫如何？齐鲁青未了。",
      "造化钟神秀，阴阳割昏晓。",
      "荡胸生曾云，决眦入归鸟。",
      "会当凌绝顶，一览众山小。"
    ],
    "form": "五言律诗",
